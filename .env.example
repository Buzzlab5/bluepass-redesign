# Database — this app's own Supabase Postgres instance. Confirmed 2026-08-06: NOT shared with Kai
# (different Supabase projects/regions) - any data flow to/from Kai goes through the KAI_CORE_* HTTP
# bridge below, not a shared DB connection.
DATABASE_URL=""
# Session-mode connection (no pgbouncer=true), used only by the Prisma CLI for migrate/db push -
# a transaction-mode pooled DATABASE_URL hangs forever on those (no error) since they need an
# advisory lock. Usually the same host/credentials as DATABASE_URL with port 5432 instead of 6543.
DIRECT_URL=""
NEXT_PUBLIC_SITE_URL="https://bluepass.co"
BLUEPASS_APP_URL="https://bluepass.co"

BLUEPASS_ADMIN_EMAILS=""
BLUEPASS_TEST_OPERATOR_PHONE=""
INTERNAL_SERVICE_TOKEN=""
BLUEPASS_SERVICE_TOKEN=""
CRON_SECRET=""

# Kai Core bridge — must point at the real, already-deployed Kai service, never localhost.
KAI_CORE_ENABLED="true"
KAI_CORE_BASE_URL="https://your-kai-core.vercel.app"
KAI_CORE_WIDGET_KEY=""
KAI_CORE_WIDGET_KEY_AU=""
KAI_CORE_ORIGIN="https://bluepass.co"
KAI_CORE_ADMIN_TOKEN=""
# Sent as the x-kai-internal-token header to Kai's GET /api/internal/rezdy-agent/marketplace-products
# - must match the REZDY_AGENT_SYNC_TOKEN value set on the Kai side, distinct from KAI_CORE_ADMIN_TOKEN.
REZDY_AGENT_SYNC_TOKEN=""

META_GRAPH_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_ID_KAI=""
WHATSAPP_PHONE_ID_OPS=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_OPERATOR_INQUIRY_SEND_MODE="template"
KAI_DEBUG="false"

KAI_LLM_ENABLED="true"
KAI_LLM_PROVIDER="groq"
KAI_LLM_MODEL=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

AUTH_EMAIL_FROM=""
RESEND_API_KEY=""

# Storage. The service role key is what enables the blog editor's drag-and-drop image upload;
# find it at Supabase dashboard -> Project Settings -> API -> service_role. It bypasses RLS,
# so it is server-only and must never be given a NEXT_PUBLIC_ prefix. The "blog-images" bucket
# creates itself on the first upload (lib/services/storage/blog-images.ts); "operator-listings"
# is still manual. With no key set, the editor falls back to pasting image URLs.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

BOKUN_ACCESS_TOKEN=""
BOKUN_API_BASE=""
BOKUN_OCTO_SUPPLIER_ID=""
BOKUN_REST_ACCESS_KEY=""
BOKUN_REST_SECRET_KEY=""
BOKUN_REST_API_BASE=""
BOKUN_WEBHOOK_SECRET=""

BOOKING_CREDENTIALS_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Booking CMS (native rails). This app charges for native bookings itself, so it needs a key on
# the Bluepass Stripe account. Use a RESTRICTED key (rk_...) with only: Checkout Sessions write,
# Refunds write, Transfers write, PaymentIntents read. Without it the booking page says online
# payment is not switched on and holds no seats.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint /api/webhooks/stripe-rails, subscribed to
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired.
STRIPE_RAILS_WEBHOOK_SECRET=""
# "true" lets the daily /api/cron/rails-settle run pay operators by Stripe Connect transfer after
# their trips have run. Anything else: holds are still tidied, nobody is paid.
NATIVE_SETTLEMENT_ENABLED=""

# Google Calendar for operators (booking CMS). An OAuth client of type "Web application" in a
# Google Cloud project with the Calendar API enabled. Authorised redirect URI:
#   https://bluepass.co/api/google/oauth/callback
# Scopes requested: openid, email, calendar.app.created, calendar.calendarlist.readonly,
# calendar.freebusy. While the consent screen is in "Testing", only listed test users can
# connect and Google expires their access after 7 days; publish and verify it before launch.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional. Defaults to NEXT_PUBLIC_SITE_URL + /api/google/oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=""

# "true" sends booking-CMS WhatsApp messages (guest confirmations, reminders, cancellations,
# operator alerts and evening summaries) from the templates in docs/whatsapp-templates.md.
# Leave unset until Meta has approved every one of them; until then those messages are
# recorded as skipped and email carries on alone.
WHATSAPP_RAILS_ENABLED=""

# Rezdy, as a booking-CMS channel (lib/services/channels/rezdy). Bluepass's own Rezdy AGENT
# account key: one key reads every operator who shares trips with Bluepass and books them. Rezdy
# allows 100 calls a minute per key. Leave REZDY_API_URL unset for production
# (https://api.rezdy.com/v1); https://api.rezdy-staging.com/v1 needs a staging account's own key.
# Automated-payment trips tokenise the card on Rezdy's Stripe account with Rezdy's published
# publishable key, chosen to match the environment; set REZDY_STRIPE_PUBLISHABLE_KEY only if Rezdy
# changes it. REZDY_WEBHOOK_SECRET goes in the webhook URL set up in Bluepass's Rezdy account
# (Integrations, Webhooks, Updated Order and Cancelled Order):
#   https://bluepass.co/api/channels/rezdy/webhook?key=<REZDY_WEBHOOK_SECRET>
# With REZDY_API_KEY set, the Discover sync reads the marketplace directly instead of through Kai.
REZDY_API_KEY=""
REZDY_API_URL=""
REZDY_STRIPE_PUBLISHABLE_KEY=""
REZDY_WEBHOOK_SECRET=""

# FareHarbor, as a booking-CMS channel. Bluepass's affiliate shortname in the FareHarbor
# Distribution Network, once FareHarbor issues it. FareHarbor trips sell only through links that
# carry it, so leave it unset until Bluepass is an FHDN affiliate.
FAREHARBOR_AFFILIATE_SHORTNAME=""

# "Coming soon" waitlist popup - "true" shows it site-wide (marketing pages only); unset/anything else hides it.
WAITLIST_POPUP_ENABLED=""
