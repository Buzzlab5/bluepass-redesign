enum CronRunStatus {
  SUCCESS
  PARTIAL
  FAILURE
}

// Milestone 3.5 (BOOKING_INTEGRATION_PLAN.md's "per-platform monitoring: availability freshness,
// booking-write failures, cancellations sync") - one row per cron job execution, written by the cron
// route itself (see /api/cron/rezdy-agent-sync) so a job that silently stops running or starts
// failing leaves a queryable trail instead of Discover quietly going stale with nobody noticing.
// Same shape as Kai's CronRunLog (kept as two separate models, not shared, since the two apps run on
// separate databases with no cross-repo Prisma relations).
model CronRunLog {
  id           String        @id @default(cuid())
  jobName      String
  status       CronRunStatus
  summary      Json?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime      @default(now())

  @@index([jobName, finishedAt])
}

// Blog / editorial CMS ---------------------------------------------------------------------------
// Added 2026-09-14. The whole point of this surface is organic search: a founder searching
// "Bluepass" - or "best liveaboard Komodo" - should land on pages Bluepass itself owns. So the
// model carries the SEO fields as first-class columns rather than a loose JSON blob: every one of
// them ends up in a <title>, a <meta>, a canonical, or the JSON-LD, and a column is what lets the
// admin list ask "which posts have no focus keyword yet" without reading every row's body.

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

// Which schema.org type the article emits. Article is right for almost everything; the other two
// exist because an FAQ or a step-by-step guide earns a rich result that a plain Article does not.
enum BlogStructuredData {
  ARTICLE
  FAQ_PAGE
  HOW_TO
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  // Sort key for the public category chips - lowest first, ties broken by name.
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@index([position])
}

model BlogPost {
  id         String @id @default(cuid())
  title      String
  // The public URL. Unique because it *is* the address - two posts sharing one would make the
  // second unreachable, and a 200 that serves the wrong article is worse for search than a 404.
  slug       String @unique
  // A display name, not a relation to BluePassAccount. The byline is editorial ("Bluepass Crew",
  // a guest operator's name) and should survive the staff account that typed it being deleted.
  authorName String @default("Bluepass")

  // Body is Markdown, rendered server-side by lib/services/blog/markdown.ts. Stored as source
  // rather than HTML so the renderer can be improved (heading anchors, link rel rules, JSON-LD
  // extraction) without a migration over every published article.
  bodyMarkdown String   @default("")
  excerpt      String?
  tags         String[] @default([])

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  heroImageUrl String?
  heroImageAlt String?

  // Search appearance. Each falls back to a sensible source when empty (seoTitle -> title,
  // metaDescription -> excerpt -> opening of the body), so a post is never *unshippable* for
  // missing one - the editor's checklist nags instead.
  focusKeyword    String?
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  structuredData  BlogStructuredData @default(ARTICLE)
  // Landing pages and thin announcements that should exist but never rank. Drops the post from
  // the sitemap as well as emitting noindex - a sitemap entry for a noindex page is a crawl
  // budget leak, not a neutral no-op.
  noindex         Boolean            @default(false)

  shareTitle       String?
  shareDescription String?
  shareImageUrl    String?

  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?

  // Derived from bodyMarkdown on every save. Denormalised because the listing pages sort and
  // summarise on them, and recomputing a Markdown parse per row per request to print "12 min
  // read" would be the most expensive thing on the page.
  wordCount      Int @default(0)
  readingMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([updatedAt])
}

// ─── Agent runtime ─────────────────────────────────────────────────────────
// The substrate the BluePass agents run on. AgentJob is the durable queue:
// one row per (agent, trigger key), so a replayed webhook or a cron that
// fires twice cannot run an agent twice. AgentRun is the log every run
// writes, including what it cost. AgentDecision is the short list of things
// that wait for a person, each with a deadline and a safe default applied
// when nobody answers.

enum AgentJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AgentDecisionStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model AgentJob {
  id          String         @id @default(cuid())
  agentId     String
  kind        String
  triggerKey  String
  payload     Json?
  status      AgentJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  runAfter    DateTime       @default(now())
  lockedAt    DateTime?
  lastError   String?
  runId       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([agentId, triggerKey])
  @@index([status, runAfter])
  @@index([agentId, createdAt])
}

model AgentRun {
  id              String         @id @default(cuid())
  agentId         String
  jobId           String?
  triggerKey      String
  status          AgentRunStatus @default(RUNNING)
  model           String?
  inputTokens     Int            @default(0)
  outputTokens    Int            @default(0)
  cacheReadTokens Int            @default(0)
  toolCalls       Json?
  outcome         Json?
  error           String?
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?

  @@index([agentId, startedAt])
  @@index([status, startedAt])
}

model AgentDecision {
  id            String              @id @default(cuid())
  agentId       String
  runId         String?
  kind          String
  title         String
  summary       String
  payload       Json?
  options       Json?
  defaultAction String
  assignee      String
  status        AgentDecisionStatus @default(PENDING)
  decision      String?
  decidedBy     String?
  decidedAt     DateTime?
  expiresAt     DateTime
  onResolve     Json?
  entityType    String?
  entityId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, expiresAt])
  @@index([entityType, entityId])
  @@index([agentId, createdAt])
}

// ─── Agent learning ────────────────────────────────────────────────────────
// What an agent has learned from its own outcomes. This is not model
// training: it is durable context an agent reads before it acts, derived
// from evidence already in the database (what the Verifier blocked, how
// operators replied, where a person drew the line on a decision).
//
// A lesson is PROPOSED by the Coach and does nothing until a person makes
// it ACTIVE. That gate is the whole safety property: an agent that could
// write its own instructions unreviewed would eventually write away the
// instructions that constrain it.

enum AgentLessonStatus {
  PROPOSED
  ACTIVE
  REJECTED
  RETIRED
}

model AgentLesson {
  id              String            @id @default(cuid())
  agentId         String
  // When this applies, in the agent's own terms, e.g. "first touch to a
  // Rezdy operator". Kept narrow so a lesson cannot quietly become a rule.
  scope           String
  lesson          String
  // The runs, outcomes and counts behind it. A lesson with no evidence is
  // an opinion and must not be proposed.
  evidence        Json?
  status          AgentLessonStatus @default(PROPOSED)
  proposedByRunId String?
  decidedBy       String?
  decidedAt       DateTime?
  // Incremented each time an agent run loads it, so a lesson nobody ever
  // hits can be retired rather than accumulating.
  timesApplied    Int               @default(0)
  retiredReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([agentId, status])
  @@index([status, createdAt])
}

// ─── Manager layer ─────────────────────────────────────────────────────────
// A directive is a standing instruction from a principal, translated from
// plain language into the four settings a manager may change on its agents:
// scope, pace, pause and ask. Nothing here can reach the copy rules, a
// gate, a manual-only channel or an agent's tool allow-list; those are
// enforced in code that never reads a directive.
//
// A manager report is generated from queries, never from an agent's own
// account of itself, and carries the row ids behind each figure so a claim
// can be checked rather than trusted.

enum AgentDirectiveStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model AgentDirective {
  id          String               @id @default(cuid())
  // The manager that owns it, or a single agent when it is narrower.
  scopeType   String
  scopeId     String
  // What the principal actually said, kept verbatim so the translation can
  // be checked against the intent.
  instruction String
  // The structured translation: region, category, pause, pace multiplier.
  levers      Json
  issuedBy    String
  status      AgentDirectiveStatus @default(ACTIVE)
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([scopeType, scopeId, status])
  @@index([status, expiresAt])
}

model ManagerReport {
  id        String   @id @default(cuid())
  managerId String
  reportsTo String
  period    String
  // Figures, each with the query behind it.
  metrics   Json
  headline  String
  concerns  Json?
  // Row ids behind the claims, so a figure can be checked.
  citations Json?
  runId     String?
  createdAt DateTime @default(now())

  @@index([managerId, createdAt])
  @@index([reportsTo, createdAt])
}

// ---------------------------------------------------------------------------
// Native booking rails
//
// The inventory for operators who have no booking system at all. Roughly 480 of
// the ~780 Australian marine businesses we have identified run on a phone and an
// inbox, and almost all Indonesian supply does; no connector can ever reach them
// because there is nothing on the other end to connect to.
//
// The whole design turns on one constraint: an operator who has never kept a
// booking calendar will not start keeping one. That is precisely why they have no
// system today. So availability here is a RULE the operator states once ("we run
// Tuesday, Thursday and Saturday at 8am, twelve seats, closed in cyclone season")
// and not a row per day. Departures are derived from the rule at query time.
// Nothing needs maintaining for the rails to stay correct next month.
//
// Seats sold are tracked separately, against a specific departure instant, so
// capacity nets down without anyone generating a year of calendar rows.
// ---------------------------------------------------------------------------

/// When a listing runs. One row is a recurring pattern, not a single departure.
model ListingSchedule {
  id        String @id @default(cuid())
  listingId String

  /// Operator-facing name when a listing has more than one pattern, e.g. "Morning reef trip".
  label String?

  /// Days this departs, 0 = Sunday through 6 = Saturday. Empty means every day.
  weekdays Int[]

  /// Local departure times as "HH:MM", 24 hour. One pattern can run several times a day.
  departureTimes String[]

  /// Season window. Null on both means the pattern runs all year.
  seasonStart DateTime?
  seasonEnd   DateTime?

  /// Seats per departure. This is the number that nets down as bookings are taken.
  capacityPerDeparture Int
  /// Departures below this do not run, so Kai must not confirm one.
  minGuests            Int @default(1)

  /// Hours before departure that bookings close. A dive boat needs the manifest the
  /// night before; a jetski does not. Stated by the operator, enforced here.
  cutoffHours    Int @default(24)
  /// How far ahead bookings are accepted.
  maxAdvanceDays Int @default(365)

  /// IANA zone. Departure times are local to the operator, never to the traveller.
  timezone String @default("Australia/Brisbane")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, active])
}

/// Dates a listing does not run despite its schedule: maintenance, weather, holidays.
model ListingBlackout {
  id        String @id @default(cuid())
  listingId String

  /// Inclusive date range, interpreted in the schedule's timezone.
  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

/// What a seat costs. Several rows per listing allow adult/child and seasonal pricing.
model ListingRate {
  id        String @id @default(cuid())
  listingId String

  /// Operator-facing label, e.g. "Adult", "Child 4-14", "Peak season adult".
  label       String
  amountCents Int
  currency    String @default("AUD")

  /// True bills per guest; false is a flat charge for the whole booking, which is
  /// how private charters are priced.
  perGuest Boolean @default(true)

  /// Age band this rate applies to. Null bounds mean unbounded on that side.
  minAge Int?
  maxAge Int?

  /// Season window, same convention as the schedule.
  seasonStart DateTime?
  seasonEnd   DateTime?

  /// The rate quoted when no age is known. Exactly one per listing should carry it,
  /// and it is what Kai uses for an unqualified "how much for two people".
  isDefault Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, active])
}

/// Seats taken on one specific departure.
///
/// Stored per departure instant rather than as generated calendar rows, so a listing
/// costs nothing to carry until somebody actually books it. A hold expires; a
/// confirmed seat does not.
model ListingSeatHold {
  id        String @id @default(cuid())
  listingId String

  /// The exact departure, stored in UTC and derived from the schedule.
  departsAt DateTime
  seats     Int

  /// Null once confirmed. A hold past its expiry is ignored when counting capacity,
  /// so an abandoned checkout releases its seats without a cleanup job.
  expiresAt DateTime?
  confirmed Boolean   @default(false)

  /// What claimed these seats, for tracing back to the booking or enquiry.
  bookingId String?
  inquiryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, departsAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Booking CMS
//
// The write side of the native rails: what turns "this trip runs Tuesdays at 8am"
// into seats a traveller can pay for and a manifest the skipper can read on the
// jetty. Built for the operator who has never had a booking system, so every
// screen behind it asks for a decision once and never for upkeep.
// ---------------------------------------------------------------------------

enum ListingBookingStatus {
  /// Seats are held while the traveller pays. Lapses on its own if they never do.
  PENDING_PAYMENT
  /// Paid, and waiting for the operator to accept it in their own booking system
  /// (a Rezdy product that confirms by hand). Becomes CONFIRMED or CANCELLED there.
  REQUESTED
  CONFIRMED
  CANCELLED
  /// The checkout was abandoned and the hold ran out. Kept, not deleted, so the
  /// operator can see demand they nearly had.
  EXPIRED
}

enum ListingBookingSource {
  /// The public booking page or the widget on the operator's own site.
  ONLINE
  /// Sold through Kai, over the same API any agent can call.
  KAI
  /// Entered by the operator: a phone call, a walk-up, a booking from a hotel desk.
  OPERATOR
}

enum ListingPaymentStatus {
  UNPAID
  /// Paid online. Bluepass holds the money until the trip runs.
  PAID
  /// Collected by the operator directly. Bluepass never touched it, so no 5% and no fee.
  PAID_TO_OPERATOR
  /// Charged by the operator's booking system (Rezdy automated payments), which pays the
  /// operator and Bluepass's commission itself. Bluepass never holds it; the 5% comes out
  /// of that commission.
  PAID_VIA_CHANNEL
  PARTIALLY_REFUNDED
  REFUNDED
}

/// One departure the operator has changed by hand: closed for weather, or a bigger
/// boat on a busy Saturday. Only exists when something differs from the rule, so a
/// listing with no exceptions has no rows here at all.
model ListingDepartureOverride {
  id        String   @id @default(cuid())
  listingId String
  departsAt DateTime

  /// No new bookings. Existing ones stand unless the departure is cancelled.
  closed   Boolean @default(false)
  /// Replaces the schedule's capacity for this one departure.
  capacity Int?
  /// Shown to the operator, and to travellers when the departure is closed.
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, departsAt])
}

/// A booking on a native-rails listing. Seats it occupies live in ListingSeatHold
/// (bookingId points back here); this row is the commercial record around them.
model ListingBooking {
  id                String  @id @default(cuid())
  /// Short and unambiguous, e.g. "BP-7K3QX9". Read aloud on the phone, so it never
  /// contains 0/O or 1/I.
  reference         String  @unique
  listingId         String
  operatorProfileId String
  scheduleId        String?

  departsAt DateTime
  /// The operator's IANA zone at the time of booking. Copied so the confirmation and
  /// manifest read the same local time even if the schedule is later edited.
  timezone  String
  guests    Int

  /// The priced lines as sold. Copied, not referenced, so a later rate change never
  /// rewrites what a traveller already paid for.
  lines      Json
  totalCents Int
  currency   String

  /// The fixed 5% to the reef. Online bookings only; zero when the operator took the
  /// money themselves, because Bluepass handled none of it.
  conservationCents Int @default(0)
  /// What the operator is owed once the trip has run. Online bookings only.
  operatorNetCents  Int @default(0)

  status        ListingBookingStatus @default(PENDING_PAYMENT)
  source        ListingBookingSource
  paymentStatus ListingPaymentStatus @default(UNPAID)

  leadName  String
  leadEmail String?
  leadPhone String?
  notes     String?

  referralCode String?

  /// The guest agreed to messages about this booking on WhatsApp, from this operator and
  /// Bluepass. Recorded per booking because consent belongs to the person who gave it.
  whatsappOptIn Boolean @default(false)
  /// Opens the guest's own booking page (/trip/[token]). Unguessable, never the id.
  guestToken    String? @unique

  /// While PENDING_PAYMENT: when the held seats lapse.
  expiresAt DateTime?

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?
  paidAt                  DateTime?
  refundedCents           Int       @default(0)

  /// Operator payout, made after the departure has run.
  settledAt        DateTime?
  stripeTransferId String?

  checkedInAt  DateTime?
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  /// Copied from the listing when booked: which system holds this booking's seats.
  channel           PmsPlatform @default(NATIVE)
  /// The booking's number in that system (a Rezdy order number). What the crew sees.
  externalReference String?     @unique
  /// That system's own status for it, as last read.
  externalStatus    String?
  externalSyncedAt  DateTime?
  /// What the channel says Bluepass earns on this booking (Rezdy's commission). The
  /// operator's payout is the fare less this, never less a rate Bluepass picked itself.
  commissionCents   Int?
  /// Answers to the operator's booking questions and the pickup chosen, as sent to
  /// their system: { fields, participants, pickup }.
  answers           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict, not Cascade: a booking is a financial record. Removing the listing or
  /// the operator behind a paid booking has to be a deliberate act, never a side effect.
  listing         OperatorListing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  operatorProfile OperatorProfile       @relation(fields: [operatorProfileId], references: [id], onDelete: Restrict)
  events          ListingBookingEvent[]
  notifications   RailsNotification[]

  @@index([listingId, departsAt])
  @@index([operatorProfileId, departsAt])
  @@index([status, expiresAt])
  @@index([leadEmail])
}

/// What happened to a booking and who did it, in order. The operator's answer to
/// "why was this refunded".
model ListingBookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  actor     String
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  booking ListingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ---------------------------------------------------------------------------
// Calendar and WhatsApp
//
// Operators already live in two places: the calendar on their phone and WhatsApp.
// The booking CMS goes to them there instead of asking them to check a dashboard.
// ---------------------------------------------------------------------------

enum GoogleConnectionStatus {
  CONNECTED
  /// Google no longer accepts the token: revoked, or the app is still in Google's
  /// testing mode, where access lapses after seven days.
  NEEDS_RECONNECT
}

/// An operator's Google account, connected so their departures appear in their own
/// calendar and their own busy times close departures.
model OperatorGoogleConnection {
  id                 String                 @id @default(cuid())
  operatorProfileId  String                 @unique
  googleEmail        String
  /// encryptCredentials({ refreshToken }). Access tokens last an hour and are fetched
  /// for each sync, never stored.
  encryptedTokens    String
  scopes             String[]
  /// The "Bluepass bookings" calendar created in their account to hold departures.
  bookingsCalendarId String?
  status             GoogleConnectionStatus @default(CONNECTED)
  lastSyncedAt       DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)
}

/// One departure mirrored as one event in the operator's Google Calendar. A row exists
/// only once something has been booked on the departure.
model DepartureCalendarEvent {
  id            String    @id @default(cuid())
  listingId     String
  departsAt     DateTime
  googleEventId String?
  /// Set whenever the departure's bookings change; cleared by a successful sync.
  dirtyAt       DateTime?
  syncedAt      DateTime?
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, departsAt])
  @@index([dirtyAt])
}

/// A stretch of time an operator is busy in one of their own Google calendars. Read
/// through FreeBusy, so it carries no titles: Bluepass learns when, never what.
model OperatorBusyBlock {
  id                String   @id @default(cuid())
  operatorProfileId String
  calendarId        String
  startsAt          DateTime
  endsAt            DateTime
  syncedAt          DateTime @default(now())

  @@index([calendarId, startsAt])
  @@index([operatorProfileId])
}

/// How an operator wants to hear about bookings, and the secret in their calendar feed.
model OperatorRailsSettings {
  id                  String   @id @default(cuid())
  operatorProfileId   String   @unique
  whatsappNewBooking  Boolean  @default(true)
  whatsappDailyDigest Boolean  @default(true)
  emailNewBooking     Boolean  @default(true)
  /// Local hour the evening-before summary goes out.
  digestHour          Int      @default(17)
  /// Secret in the subscribe-by-URL calendar feed. A new one revokes the old link.
  calendarFeedToken   String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)
}

enum RailsNotificationChannel {
  WHATSAPP
  EMAIL
}

enum RailsNotificationAudience {
  TRAVELLER
  OPERATOR
}

enum RailsNotificationStatus {
  /// Claimed by a sender, not yet accepted by the provider.
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  /// Deliberately not sent: no consent, no number, or the channel is not switched on.
  SKIPPED
}

/// Every message sent about a booking or to an operator, and what became of it.
model RailsNotification {
  id                String                    @id @default(cuid())
  operatorProfileId String
  bookingId         String?
  channel           RailsNotificationChannel
  audience          RailsNotificationAudience
  /// booking_confirmed, trip_reminder, booking_cancelled, departure_update,
  /// operator_new_booking or operator_daily_digest.
  kind              String
  recipient         String
  status            RailsNotificationStatus   @default(QUEUED)
  /// Makes each message once-only: one reminder per booking, one digest per evening.
  dedupeKey         String?                   @unique
  providerMessageId String?                   @unique
  /// Why it failed or was skipped, in words an operator can act on.
  detail            String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)
  booking         ListingBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([operatorProfileId, createdAt])
}

// ---------------------------------------------------------------------------
// Channels: Rezdy and FareHarbor
//
// An operator who already runs Rezdy or FareHarbor keeps running it. Their trips
// come to Bluepass from there and their seats stay there, so nothing is ever sold
// twice. Rezdy is read and booked through Bluepass's agent account; FareHarbor sells
// through its own checkout with Bluepass's affiliate tag, because FareHarbor gives
// affiliates no data access below its API threshold.
// ---------------------------------------------------------------------------

enum ChannelConnectionStatus {
  /// The operator's account exists, but they have not shared trips with Bluepass yet
  /// (no Rezdy rate for Bluepass, or no FareHarbor link carrying Bluepass's affiliate tag).
  WAITING
  CONNECTED
  /// It worked before and does not now: trips withdrawn, account gone, or access refused.
  BROKEN
}

/// An operator's Rezdy or FareHarbor account, connected so their trips sell on Bluepass.
model OperatorChannelConnection {
  id                String                  @id @default(cuid())
  operatorProfileId String
  platform          PmsPlatform
  status            ChannelConnectionStatus @default(WAITING)
  /// Rezdy: the company alias ("reefrunner" in reefrunner.rezdy.com).
  /// FareHarbor: the company shortname ("reefrunner" in fareharbor.com/reefrunner).
  accountKey        String
  /// Rezdy's numeric supplier id, once known.
  externalId        String?
  displayName       String?
  timezone          String?
  currency          String?
  /// New trips in the operator's system appear on Bluepass without anyone asking.
  autoPublish       Boolean                 @default(true)
  lastSyncedAt      DateTime?
  lastCheckedAt     DateTime?
  /// In words the operator can act on.
  lastError         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)

  @@unique([platform, accountKey])
  @@unique([operatorProfileId, platform])
  @@index([status])
}

/// One traveller sent to an operator's FareHarbor checkout. Its reference travels as
/// FareHarbor's affiliate voucher number, so the booking it becomes can be matched back
/// to the trip and to whoever referred the traveller.
model ChannelHandoff {
  id                String      @id @default(cuid())
  reference         String      @unique
  listingId         String
  operatorProfileId String
  channel           PmsPlatform
  referralCode      String?
  createdAt         DateTime    @default(now())

  listing         OperatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([operatorProfileId, createdAt])
}

/// Where a channel's incremental reads last stopped ("rezdy:bookings" -> an ISO time).
model ChannelCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A page Bluepass prepares for an operator from their own published information, held
/// back until a person has checked it against the source. The trips on it are
/// OperatorListing rows (DRAFT, each with its own check in channelData.qc); this row
/// holds the operator-level copy and the page's own check.
model PreparedOperatorPage {
  id               String    @id @default(cuid())
  /// Matches OperatorLead.slug and the page at /operators/[slug].
  slug             String    @unique
  /// Operator-level copy and facts: summary, standouts, hero, contact, offers, sources, notes.
  data             Json
  /// pending, approved or needs_fix.
  qcStatus         String    @default("pending")
  qcNotes          String?
  reviewedBy       String?
  reviewedAt       DateTime?
  /// The photos are linked from the operator's own website. Travellers see only the ones
  /// the operator has approved, which they do once their claim on the page is approved.
  photosApproved   String[]  @default([])
  photosApprovedAt DateTime?
  photosApprovedBy String?
  /// Every photo on the page when the operator last chose, so a photo added by a later
  /// import is asked about rather than silently left out.
  photosSeen       String[]  @default([])
  /// Corrections made while checking (summary, standouts, contact), kept apart from what
  /// was read off the website so a re-import cannot undo them.
  edits            Json?
  editedBy         String?
  editedAt         DateTime?
  /// Photos, a logo and videos the operator added themselves after claiming: theirs to
  /// publish, so always shown, and never touched by a re-import from the website.
  operatorMedia    Json?
  operatorMediaAt  DateTime?
  importedAt       DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// A creator an operator can pick during onboarding to feature their trips: someone with a
/// Bluepass creator account (partnerProfileId set), or someone from Bluepass's research list
/// whom Bluepass invites by hand once an operator picks them. Matched to operators by place
/// and by what they make (specialties).
model Creator {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  brand            String?
  website          String?
  instagram        String?
  youtube          String?
  tiktok           String?
  /// A business contact the creator publishes on their own site; used only for a person's invite.
  contactEmail     String?
  baseState        String?
  baseTown         String?
  regions          String[]            @default([])
  specialties      String[]            @default([])
  summary          String?
  sourceUrl        String?
  /// "research" (from the creator research list) or "partner" (signed up as a creator).
  source           String
  partnerProfileId String?             @unique
  /// When a person at Bluepass invited them, after an operator picked them.
  invitedAt        DateTime?
  invitedBy        String?
  hidden           Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  partnerProfile   PartnerProfile?     @relation(fields: [partnerProfileId], references: [id], onDelete: SetNull)
  campaigns        CreatorCampaign[]
  enrolments       OutreachEnrolment[]

  @@index([baseState])
}

enum CreatorCampaignStatus {
  /// Picked by the operator; waiting for the creator to accept (or to join, then accept).
  REQUESTED
  ACCEPTED
  DECLINED
  /// The creator has shared their post; the credit is theirs once the review window passes.
  FEATURED
  /// The operator said the feature did not happen; the credit is held back for a person.
  DISPUTED
  CANCELLED
}

/// One operator's pick of one creator, with the part of the operator's creator credit set
/// aside for them.
model CreatorCampaign {
  id                String                @id @default(cuid())
  operatorAccountId String
  operatorName      String
  /// The operator's Bluepass page, where the creator's tracked link points.
  operatorPath      String?
  creatorId         String
  status            CreatorCampaignStatus @default(REQUESTED)
  creditCents       Int
  currency          String                @default("AUD")
  referralLinkId    String?               @unique
  postUrl           String?
  respondedAt       DateTime?
  featuredAt        DateTime?
  disputedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  operatorAccount   BluePassAccount       @relation(fields: [operatorAccountId], references: [id], onDelete: Cascade)
  creator           Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([operatorAccountId, creatorId])
  @@index([creatorId])
  @@index([status])
}

enum OperatorCreditKind {
  WELCOME_GRANT
  CAMPAIGN_HOLD
  CAMPAIGN_RELEASE
}

/// The operator's creator credit as a ledger: the welcome grant, credit set aside for a
/// creator they picked, and credit returned when that creator declines.
model OperatorCreditEntry {
  id                String             @id @default(cuid())
  operatorAccountId String
  kind              OperatorCreditKind
  /// Positive for grants and releases, negative for holds.
  amountCents       Int
  currency          String             @default("AUD")
  campaignId        String?
  /// Grants only: unspent grant credit cannot be set aside after this.
  expiresAt         DateTime?
  /// Makes a grant or a ledger move happen once, e.g. "welcome:<accountId>".
  onceKey           String?            @unique
  createdAt         DateTime           @default(now())
  operatorAccount   BluePassAccount    @relation(fields: [operatorAccountId], references: [id], onDelete: Cascade)

  @@index([operatorAccountId])
}

/// Who a cold-outreach campaign is for. Operators come from OperatorLead, creators from Creator.
enum OutreachAudience {
  OPERATOR
  CREATOR
}

enum OutreachEnrolmentStatus {
  /// Handed to Instantly; the sequence is running.
  ENROLLED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  BOUNCED
  UNSUBSCRIBED
  /// Taken out of the sequence by something that happened on Bluepass (claimed, joined, a person took over).
  STOPPED
  /// The sequence ran to the end without an answer.
  COMPLETED
}

/// One person in one cold-email sequence. The sequence itself runs in Instantly; this is Bluepass's record of it.
model OutreachEnrolment {
  id              String                  @id @default(cuid())
  audience        OutreachAudience
  campaignKey     String
  email           String
  operatorLeadId  String?
  creatorId       String?
  status          OutreachEnrolmentStatus
  /// The first message as it was sent, so the record stands without Instantly.
  subject         String
  body            String
  /// Why Bluepass may email this address (Spam Act: a business address the recipient publishes).
  consentBasis    String
  instantlyLeadId String?
  stopReason      String?
  lastEventAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  operatorLead    OperatorLead?           @relation(fields: [operatorLeadId], references: [id], onDelete: SetNull)
  creator         Creator?                @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  events          OutreachEvent[]

  @@unique([email, campaignKey])
  @@index([operatorLeadId])
  @@index([creatorId])
  @@index([status])
}

/// Addresses that must never get cold email again: unsubscribed, bounced, said no, or asked by a person.
model OutreachSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  source    String
  createdAt DateTime @default(now())
}

/// Everything Instantly reported, once each: deliveries are retried, so the key makes them safe to replay.
model OutreachEvent {
  id          String             @id @default(cuid())
  dedupeKey   String             @unique
  type        String
  email       String?
  enrolmentId String?
  campaignId  String?
  payload     Json
  /// A reply that waits for a person, until someone marks it handled.
  needsPerson Boolean            @default(false)
  handledAt   DateTime?
  handledBy   String?
  createdAt   DateTime           @default(now())
  enrolment   OutreachEnrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  @@index([enrolmentId])
  @@index([type])
  @@index([needsPerson, handledAt])
}
