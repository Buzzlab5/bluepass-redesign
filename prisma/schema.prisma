generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OperatorStatus {
  GHOST
  CLAIMED
  ACTIVE
  SUSPENDED
}

enum PmsPlatform {
  REZDY
  FAREHARBOR
  BOKUN
  NATIVE
}

enum CertLevel {
  NONE
  OW
  AOW
  RESCUE
  DIVEMASTER
  INSTRUCTOR
}

enum BookingStatus {
  QUOTE_DRAFTED
  OPERATOR_NOTIFIED
  OPERATOR_ACCEPTED
  OPERATOR_DECLINED
  COUNTER_REQUESTED
  AUTO_DECLINED
  PMS_HOLD_PLACED
  AWAITING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ActorType {
  TRAVELLER
  OPERATOR
  SYSTEM
  KAI
}

enum TransferStatus {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

enum SignupRole {
  OPERATOR
  PARTNER
}

enum WaitlistRole {
  OPERATOR
  PARTNER
  TRAVELLER
}

// The "we're still building this" popup's own lead capture - deliberately separate from
// SignupLead. SignupLead's /api/signup is an account-bound real application (creates a real
// OperatorProfile/PartnerProfile in PENDING_REVIEW); this is anonymous, pre-account interest
// capture only ("just a form so if people are interested... they can join the waiting list" -
// Tony, 2026-08-27), meant to be emailed once the platform is actually ready, not reviewed now.
model WaitlistSignup {
  id        String       @id @default(cuid())
  email     String
  name      String?
  role      WaitlistRole
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([email])
}

enum BluePassAccountRole {
  TRAVELLER
  PARTNER
  OPERATOR
  ADMIN
}

enum ApplicationStatus {
  PENDING_REVIEW
  APPROVED
  DECLINED
  LIVE
}

enum OperatorClaimStatus {
  PENDING_REVIEW
  APPROVED
  DECLINED
}

enum OperatorLeadStatus {
  IMPORTED
  CLAIM_LINK_REQUESTED
  CLAIM_SUBMITTED
  APPROVED
  LIVE
  DECLINED
  MANUAL_REVIEW
  // BD outreach states. The values above describe the self-service claim funnel a lead can be put
  // through; these two cover the manual path BD actually works day to day - someone was called or
  // emailed (CONTACTED), and they answered and a conversation is open (IN_DISCUSSION). A lead that
  // signs still lands on APPROVED, so both paths converge.
  CONTACTED
  IN_DISCUSSION
}

enum OperatorPmsReadinessStatus {
  NEEDS_CREDENTIALS
  CREDENTIALS_SUBMITTED
  CONNECTED
  SYNCED
  MANUAL_REVIEW
}

enum KaiChannel {
  WEB      @map("web")
  WHATSAPP @map("whatsapp")
}

enum KaiSessionStatus {
  OPEN    @map("open")
  HANDOFF @map("handoff")
  CLOSED  @map("closed")
}

enum KaiMessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
}

enum BookingInquiryStatus {
  DRAFT
  READY_TO_DISPATCH
  OPERATOR_PENDING
  OPERATOR_ACCEPTED
  OPERATOR_DECLINED
  COUNTER_OFFERED
  EXPIRED
}

enum WhatsAppOutboundStatus {
  QUEUED
  SENT
  FAILED
}

enum ReferralPartnerRole {
  PARTNER
  OPERATOR
  DIVE_SHOP
  GROUP
  TRAVELLER
}

/// What kind of partner an applicant to the /partners funnel says they are. Descriptive only -
/// it does not change commission math (splitBooking has no per-audience rule) or gate any
/// dashboard feature, so this deliberately does not touch ReferralPartnerRole/PartnerProfile's
/// approval flow. It exists so an admin reviewing a "Partners" application, and the applicant's
/// own dashboard, can show something truer than the generic "Partner" role for a dive shop or
/// travel agency that applied through the same funnel. CREATOR here means "creator/influencer" -
/// a leaf category, distinct from (and not renamed alongside) the broader PARTNER role above.
enum PartnerCategory {
  CREATOR
  DIVE_SHOP
  TRAVEL_AGENCY
  TRIP_LEADER
  DIVE_INSTRUCTOR
  ADVISOR
  OCEAN_PARTNER
}

model Operator {
  id                       String                    @id @default(cuid())
  name                     String
  status                   OperatorStatus            @default(GHOST)
  whatsappE164             String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  trips                    Trip[]
  bookings                 Booking[]
  integrations             OperatorIntegration[]
  bookingInquiries         BookingInquiry[]
  whatsappOutboundMessages WhatsAppOutboundMessage[]
}

model ReferralPartner {
  id               String                 @id @default(cuid())
  role             ReferralPartnerRole
  name             String
  handle           String?
  email            String?
  phone            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  links            ReferralLink[]
  clicks           ReferralClick[]
  kaiSessions      KaiSession[]
  bookingInquiries BookingInquiry[]
  partnerProfiles  PartnerProfile[]
  operatorProfiles OperatorProfile[]
  payoutRequests   PartnerPayoutRequest[]

  @@index([role])
  @@index([handle])
  @@index([email])
}

enum PartnerPayoutRequestStatus {
  PENDING
  PAID
  DECLINED
}

/**
 * A partner's own request to cash out their accrued referral commission - separate from
 * CommissionLedgerEntry (which has no durable "paid" state of its own: rows are deleted+recreated
 * per booking inquiry on every resync, see commission-ledger.ts's syncReferralCommissionLedger).
 * "Available to request" is computed as the current PARTNER_COMMISSION_ESTIMATE total minus the sum
 * of this partner's PENDING/PAID requests for the same currency - see
 * lib/services/partner/payout-requests.ts.
 */
model PartnerPayoutRequest {
  id                   String                     @id @default(cuid())
  referralPartnerId    String
  requestedByAccountId String
  amountCents          Int
  currency             String
  status               PartnerPayoutRequestStatus @default(PENDING)
  paidAt               DateTime?
  paidBy               String?
  paidReference        String?
  declinedAt           DateTime?
  declinedBy           String?
  declineReason        String?
  createdAt            DateTime                   @default(now())
  referralPartner      ReferralPartner            @relation(fields: [referralPartnerId], references: [id], onDelete: Cascade)

  @@index([referralPartnerId])
  @@index([status])
}

model ReferralLink {
  id               String           @id @default(cuid())
  partnerId        String
  code             String           @unique
  label            String?
  targetPath       String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  partner          ReferralPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks           ReferralClick[]
  kaiSessions      KaiSession[]
  bookingInquiries BookingInquiry[]

  @@index([partnerId])
  @@index([active])
}

model ReferralClick {
  id                String           @id @default(cuid())
  referralLinkId    String?
  referralPartnerId String?
  code              String
  landingPath       String?
  referrer          String?
  userAgent         String?
  createdAt         DateTime         @default(now())
  referralLink      ReferralLink?    @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  referralPartner   ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)

  @@index([referralLinkId])
  @@index([referralPartnerId])
  @@index([code])
  @@index([createdAt])
}

model Trip {
  id          String    @id @default(cuid())
  operatorId  String
  externalId  String?
  title       String
  description String?
  location    String?
  imageUrl    String?
  currency    String    @default("USD")
  priceCents  Int
  minCert     CertLevel @default(NONE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  operator    Operator  @relation(fields: [operatorId], references: [id])
  bookings    Booking[]

  @@unique([operatorId, externalId])
  @@index([operatorId])
}

model Traveller {
  id                      String                            @id @default(cuid())
  whatsappE164            String                            @unique
  email                   String?                           @unique
  emailVerifiedAt         DateTime?
  passwordHash            String?
  displayName             String?
  account                 BluePassAccount?
  certLevel               CertLevel                         @default(NONE)
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  bookings                Booking[]
  kaiSessions             KaiSession[]
  sessions                TravellerSession[]
  emailVerificationTokens TravellerEmailVerificationToken[]

  @@index([email])
}

model BluePassAccount {
  id                      String                                  @id @default(cuid())
  email                   String                                  @unique
  emailVerifiedAt         DateTime?
  passwordHash            String
  displayName             String?
  // Made unique 2026-09-10: previously enforced only incidentally, via Traveller.whatsappE164's own
  // unique constraint (register.ts upserted a Traveller keyed by phone before this field existed on
  // the account directly). Now that registration no longer creates a Traveller row at all, this is
  // the sole enforcement of "one phone number, one account" - Postgres treats multiple NULLs as
  // distinct, so accounts with no phone on file don't conflict with each other.
  phone                   String?                                 @unique
  roles                   BluePassAccountRole[]                   @default([TRAVELLER])
  travellerId             String?                                 @unique
  createdAt               DateTime                                @default(now())
  updatedAt               DateTime                                @updatedAt
  traveller               Traveller?                              @relation(fields: [travellerId], references: [id], onDelete: SetNull)
  sessions                BluePassAccountSession[]
  emailVerificationTokens BluePassAccountEmailVerificationToken[]
  passwordResetTokens     BluePassAccountPasswordResetToken[]
  partnerProfile          PartnerProfile?
  operatorProfile         OperatorProfile?
  operatorClaims          OperatorClaim[]
  commissionEntries       CommissionLedgerEntry[]
  savedTrips              SavedTrip[]
  creatorCampaigns        CreatorCampaign[]
  creditEntries           OperatorCreditEntry[]

  @@index([email])
  @@index([travellerId])
}

model BluePassAccountSession {
  id        String          @id @default(cuid())
  accountId String
  tokenHash String          @unique
  expiresAt DateTime
  createdAt DateTime        @default(now())
  account   BluePassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model BluePassAccountEmailVerificationToken {
  id        String          @id @default(cuid())
  accountId String
  tokenHash String          @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  account   BluePassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([email])
  @@index([expiresAt])
}

model BluePassAccountPasswordResetToken {
  id        String          @id @default(cuid())
  accountId String
  tokenHash String          @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  account   BluePassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

/**
 * A traveller's shortlist. `tripSlug` matches `Trip.slug` from lib/discover.ts - the same identity
 * already used to key the client-side `saved` state, whether the trip is one of the 6 curated
 * examples or a real `OperatorListing.slug` synced from Rezdy. No separate Trip table exists to
 * foreign-key against, so the slug is the only shared identifier there is.
 */
model SavedTrip {
  id        String          @id @default(cuid())
  accountId String
  tripSlug  String
  createdAt DateTime        @default(now())
  account   BluePassAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tripSlug])
  @@index([accountId])
}

model PartnerProfile {
  id                     String            @id @default(cuid())
  accountId              String            @unique
  referralPartnerId      String?           @unique
  status                 ApplicationStatus @default(PENDING_REVIEW)
  handle                 String?
  audienceUrl            String?
  instagramUrl           String?
  youtubeUrl             String?
  tiktokUrl              String?
  partnerCategory        PartnerCategory?
  // Same encrypt-at-rest convention as OperatorProfile.encryptedPayoutDetails
  // (lib/services/booking/adapters/credentials.ts's encryptCredentials/decryptCredentials) - real
  // bank account data, never stored as plain JSON.
  encryptedPayoutDetails String?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  account                BluePassAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referralPartner        ReferralPartner?  @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  creator                Creator?

  @@index([status])
  @@index([handle])
  @@index([referralPartnerId])
}

// Phase 1 foundation for real commission payouts (see kai's src/core/bluepass/ledger.ts and the
// "Real commission payment collection" plan) - starts manual/admin-driven for every operator
// regardless of region; STRIPE_CONNECT becomes usable once Phase 2's Stripe Connect onboarding
// ships for AU operators specifically (Indonesia's cross-border support is unconfirmed with Stripe).
enum OperatorPayoutMethod {
  MANUAL_BANK_TRANSFER
  STRIPE_CONNECT
  // Indonesia payout rail (DEVELOPER_BRIEF_PAYMENTS_REZDY.md: "Stripe Connect cannot pay Indonesia -
  // verified"). Added 2026-08-10 as Milestone 2.5's "shape only" deliverable - the adapter
  // (Kai's src/server/payments/airwallex-adapter.ts) is a real interface + stub, not a live
  // integration, since no Airwallex account exists yet (BD/Tony's workstream, not engineering).
  // No operator has this set today; this field was already unused/unwired before this change.
  AIRWALLEX
}

model OperatorProfile {
  id                      String                      @id @default(cuid())
  accountId               String                      @unique
  referralPartnerId       String?                     @unique
  status                  ApplicationStatus           @default(PENDING_REVIEW)
  companyName             String?
  whatsappE164            String?
  websiteUrl              String?
  claimedOperatorSlug     String?
  claimedYachtSlugs       String[]                    @default([])
  claimedAt               DateTime?
  notes                   String?
  // ISO 3166-1 alpha-2 (e.g. "AU", "ID") - drives payout routing once Phase 2 Stripe Connect
  // ships; not yet collected anywhere in the onboarding flow, so expect this to be null for
  // existing operators until a follow-up backfill/onboarding-form step is built.
  country                 String?
  payoutMethod            OperatorPayoutMethod        @default(MANUAL_BANK_TRANSFER)
  // Same encrypt-at-rest convention as OperatorIntegration.encryptedCredentials
  // (lib/services/booking/adapters/credentials.ts's encryptCredentials/decryptCredentials) - this
  // is real bank account data, never stored as plain JSON.
  encryptedPayoutDetails  String?
  payoutContactEmail      String?
  // Created by kai (which holds BluePass's own Stripe secret key) via the admin bridge when the
  // operator starts Connect onboarding; bluepass-app never talks to Stripe's account-creation API
  // directly. stripeChargesEnabled/stripePayoutsEnabled/stripeOnboardedAt are updated by this
  // app's own account.updated webhook (a separate Stripe webhook endpoint, own signing secret).
  stripeConnectAccountId  String?                     @unique
  stripeChargesEnabled    Boolean                     @default(false)
  stripePayoutsEnabled    Boolean                     @default(false)
  stripeOnboardedAt       DateTime?
  // Kai's Tenant.slug (e.g. "boattime") for the operator this profile belongs to - deliberately a
  // separate field from claimedOperatorSlug, which is this app's own legacy Operator table's slug
  // namespace, never designed to match Kai's tenant slugs. Set explicitly per operator when linking
  // Kai's direct-PMS/Rezdy payout flow to this profile's stripeConnectAccountId (see
  // /api/internal/operator-payout-account) - null until that linking happens. Added 2026-08-06.
  kaiTenantSlug           String?                     @unique
  // Rezdy supplier id (from the Agent API marketplace listing), distinct from kaiTenantSlug above -
  // a Rezdy-connected operator discovered via the Discover sync has no Kai Tenant/booking flow of
  // its own, so it can't use kaiTenantSlug as its dedupe key. Set only on profiles auto-created by
  // the Rezdy Agent Discover sync (lib/services/discover/rezdy-agent-sync.ts); null for every
  // operator that signed up/claimed a page directly. Added 2026-08-06.
  rezdySupplierId         String?                     @unique
  // Structured tiered cancellation policy, e.g. [{"minDaysBeforeDeparture":14,"refundPercent":100},
  // {"minDaysBeforeDeparture":3,"refundPercent":50}, {"minDaysBeforeDeparture":0,"refundPercent":0}].
  // Null until an operator/admin sets one - same gap as `country` above, no onboarding UI collects
  // this yet. Kai's auto-refund calculator (src/core/cancellation/rules.ts) falls back to a clearly
  // labeled platform-default policy when this is null, never invents a real operator's actual terms.
  // Exposed via GET /api/internal/operator-payout-account alongside the Stripe Connect fields above.
  // Added 2026-08-10 for Milestone 3 (payment-settlement plan).
  cancellationPolicyTiers Json?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  account                 BluePassAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referralPartner         ReferralPartner?            @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  pmsReadiness            OperatorPmsReadiness?
  listings                OperatorListing[]
  listingBookings         ListingBooking[]
  googleConnection        OperatorGoogleConnection?
  railsSettings           OperatorRailsSettings?
  railsNotifications      RailsNotification[]
  channelConnections      OperatorChannelConnection[]
  channelHandoffs         ChannelHandoff[]

  @@index([status])
  @@index([companyName])
  @@index([claimedOperatorSlug])
  @@index([referralPartnerId])
}

enum OperatorListingStatus {
  DRAFT
  LIVE
  ARCHIVED
}

// A listing an operator authors and publishes themselves, once approved (OperatorProfile.status
// = APPROVED) - no admin review gate before going live, matching how most self-service
// marketplaces work (publish first, moderate reactively). Admins can only take an already-live
// listing down (ARCHIVED) and bring it back, via archivedAt/archivedBy/archivedReason.
// Deliberately hangs off OperatorProfile (the account-linked entity real claim/approval flows
// actually populate) rather than the legacy Operator/Trip/Booking tables, which are only ever
// touched by the Bokun PMS-sync adapter and have no bridge from an approved claim today.
// category/region are free strings (matching OperatorLead's existing pattern) rather than enums,
// so an Australian region (e.g. "Great Barrier Reef") needs no schema change to be listed
// alongside "Komodo"/"Raja Ampat".
model OperatorListing {
  id                String       @id @default(cuid())
  operatorProfileId String
  title             String
  slug              String       @unique
  category          String
  region            String
  description       String
  heroImageUrl      String?
  // Extra photos the operator uploaded for the trip sheet gallery, in the order shown. Empty for every
  // listing that existed before this column; the cover above is separate and is not repeated here.
  galleryUrls       String[]              @default([])
  maxGuests         Int?
  priceSignal       String?
  // Plain decimal amount backing priceSignal's display string (e.g. "From AUD 189" -> 189) - added
  // 2026-08-07 because the Discover page's Trip type needs a real number for the 5%-of-fare math and
  // "A$X /guest" formatting, and priceSignal is deliberately free text (operators can type anything
  // here via operator-listing-service.ts). Nullable/optional: existing human-authored listings won't
  // have this set, and the Discover mapping treats that the same as "no price shown."
  priceFrom         Float?
  currency          String       @default("AUD")
  // The Rezdy product code this listing was synced from (rezdy-agent-sync.ts's RezdyMarketplaceProduct.productCode)
  // - null for listings an operator authored themselves. Join key back to Kai's ManualInquiry rows
  // (Kai's PmsBookingPaymentAttempt.productExternalId is the same value on that side): the shared
  // canonical "bluepass" tenant that powers Discover's Kai widget has no per-operator ledger, only a
  // pool of manual inquiries, and this is what turns that pool back into "this operator's inquiries"
  // (see lib/services/operator/dashboard.ts's rezdy-agent branch).
  externalProductId String?
  // Where a traveller books this trip themselves when BluePass resells it as an affiliate or agent
  // rather than through Kai: a FareHarbor Distribution Network referral link, or a Rezdy agent
  // booking link. Both open the platform's own booking flow (live times, payment, confirmation),
  // so no payment touches BluePass for these trips. Null means the trip is booked through Kai.
  bookingUrl        String?
  bookingPlatform   PmsPlatform?
  // The trip on Kai's own booking system (NativeTrip.id) this listing was written from, when the
  // operator runs trips on BluePass rather than on Rezdy or FareHarbor. Publishing or unpublishing
  // that trip keeps this listing in step, so the website never shows a trip Kai cannot sell.
  nativeTripId      String?               @unique

  /// Where this trip's seats, prices and payments live. NATIVE is Bluepass's own rails
  /// (schedules and rates below). REZDY is the operator's Rezdy, read and booked through
  /// Bluepass's agent account; externalProductId is the product code. FAREHARBOR is the
  /// operator's FareHarbor, booked in FareHarbor's own checkout under Bluepass's
  /// affiliate tag; externalProductId is the item id. One trip, one source of seats:
  /// a trip is never sold from two inventories at once.
  channel            PmsPlatform @default(NATIVE)
  /// The channel's own record of the trip as last read (Rezdy: the product, with its
  /// price options, booking questions, pickups and payment terms).
  channelData        Json?
  channelSyncedAt    DateTime?
  /// Why the trip cannot be sold right now, in words the operator can act on. Null when it can.
  channelIssue       String?
  /// FareHarbor: the booking link the operator made with Bluepass as the affiliate.
  externalBookingUrl String?

  status         OperatorListingStatus @default(DRAFT)
  publishedAt    DateTime?
  archivedAt     DateTime?
  archivedBy     String?
  archivedReason String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  operatorProfile OperatorProfile @relation(fields: [operatorProfileId], references: [id], onDelete: Cascade)

  // Native booking rails. Present only for operators with no booking system of
  // their own; a Rezdy-synced listing carries externalProductId instead.
  schedules  ListingSchedule[]
  blackouts  ListingBlackout[]
  rates      ListingRate[]
  seatHolds  ListingSeatHold[]
  departures ListingDepartureOverride[]
  bookings   ListingBooking[]

  // Logistics a traveller needs once they have booked. Editable while the listing is
  // LIVE, unlike the marketing copy above: a changed meeting point is an operational
  // fact, not a new pitch, and the next confirmation email has to carry it.
  /// How long the trip runs, so a confirmation can say when guests are back.
  durationMinutes  Int?
  /// Where guests meet, printed on the confirmation and the manifest.
  meetingPoint     String?
  /// What to bring, when to arrive. Sent verbatim in every confirmation.
  confirmationNote String?

  /// One of the operator's own Google calendars. While it shows them busy, this trip's
  /// departures do not run: a private charter in their diary closes the public sailing.
  busyCalendarId String?
  calendarEvents DepartureCalendarEvent[]
  handoffs       ChannelHandoff[]

  @@index([operatorProfileId])
  @@index([status])
  @@index([region])
  @@index([channel, externalProductId])
}

model OperatorLead {
  id             String                  @id @default(cuid())
  slug           String                  @unique
  name           String
  category       String?
  region         String?
  email          String?
  phone          String?
  claimUrl       String?
  websiteUrl     String?
  source         String                  @default("csv")
  status         OperatorLeadStatus      @default(IMPORTED)
  lastOutreachAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  claimTokens    OperatorClaimToken[]
  outreachEvents OperatorOutreachEvent[]
  enrolments     OutreachEnrolment[]

  @@index([status])
  @@index([email])
  @@index([region])
}

model OperatorClaimToken {
  id             String       @id @default(cuid())
  operatorLeadId String
  tokenHash      String       @unique
  email          String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  operatorLead   OperatorLead @relation(fields: [operatorLeadId], references: [id], onDelete: Cascade)

  @@index([operatorLeadId])
  @@index([email])
  @@index([expiresAt])
}

model OperatorOutreachEvent {
  id             String        @id @default(cuid())
  operatorLeadId String?
  operatorSlug   String
  type           String
  message        String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  operatorLead   OperatorLead? @relation(fields: [operatorLeadId], references: [id], onDelete: SetNull)

  @@index([operatorLeadId])
  @@index([operatorSlug])
  @@index([type])
  @@index([createdAt])
}

model OperatorClaim {
  id            String              @id @default(cuid())
  operatorSlug  String
  operatorName  String
  yachtSlugs    String[]            @default([])
  accountId     String
  status        OperatorClaimStatus @default(PENDING_REVIEW)
  claimantName  String
  claimantEmail String
  claimantPhone String?
  claimantRole  String?
  websiteUrl    String?
  proofUrl      String?
  notes         String?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  account       BluePassAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([operatorSlug])
  @@index([accountId])
  @@index([status])
}

model OperatorPmsReadiness {
  id                String                     @id @default(cuid())
  operatorProfileId String                     @unique
  platform          PmsPlatform
  status            OperatorPmsReadinessStatus @default(NEEDS_CREDENTIALS)
  contactEmail      String?
  contactWhatsapp   String?
  notes             String?
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
